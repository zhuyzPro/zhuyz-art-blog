- const projectCenter = site.data.order_projects || {}
- const projectMeta = projectCenter.meta || {}
- const featuredProjects = (projectCenter.projects || []).filter(item => item.featured !== false).slice(0, 3)

#zhuyz-project-center(data-project-center)
  .zhuyz-project-center__head
    .zhuyz-project-center__title-wrap
      .zhuyz-project-center__eyebrow 热门项目
      h2= projectMeta.title || '热门项目'
      p= projectMeta.subtitle || '选择项目，查看完整教程与下单方式'
    .zhuyz-project-center__status
      span
      | #{projectMeta.status_label || '服务正常'}

  .zhuyz-project-center__controls
    .zhuyz-project-center__tabs(role='tablist' aria-label='项目下单方式筛选')
      button.is-active(type='button' data-project-filter='all' role='tab' aria-selected='true') 全部项目
      button(type='button' data-project-filter='keyword' role='tab' aria-selected='false') 关键词下单
      button(type='button' data-project-filter='qrcode' role='tab' aria-selected='false') 二维码入口
    label.zhuyz-project-center__search
      span.anzhiyufont.anzhiyu-icon-magnifying-glass(aria-hidden='true')
      input(type='search' data-project-search placeholder='搜索项目名称、用途或编号' aria-label='搜索项目')

  .zhuyz-project-center__list(data-project-list)
    each project in featuredProjects
      - const order = project.order || {}
      - const pricing = project.pricing || {}
      - const delivery = project.delivery || {}
      - const tutorial = project.tutorial || {}
      - const orderType = order.type || 'keyword'
      - const searchText = [project.id, project.title, project.summary, order.label].filter(Boolean).join(' ')
      a.zhuyz-project-card(href=url_for(tutorial.link || projectMeta.all_projects_link || '/guide/') data-project-card data-project-type=orderType data-project-search=searchText)
        .zhuyz-project-card__icon(class=`is-${orderType}` aria-hidden='true')= project.icon || '✦'
        .zhuyz-project-card__body
          .zhuyz-project-card__line
            h3= project.title
            span.zhuyz-project-card__tag= order.label || '查看方式'
          p= delivery.display || project.summary || '以机器人实时回复为准'
        .zhuyz-project-card__action
          strong= pricing.display || '实时报价'
          span= tutorial.label || '查看教程'

  a.zhuyz-project-center__more(href=url_for(projectMeta.all_projects_link || '/guide/'))
    span= projectMeta.all_projects_label || '进入项目中心，查看全部项目与实时状态'
    i.anzhiyufont.anzhiyu-icon-arrow-right(aria-hidden='true')
